# Terraform files
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
.terraform/
.terraform.lock.hcl

# Ansible files
*.retry
ansible/inventory.yaml
ansible/ansible.cfg

# Charts pulled locally by `kustomize build --enable-helm`. Argo re-pulls them
# on every render, so committing them would just vendor a stale copy.
apps/**/charts/

# Other
*.DS_Store