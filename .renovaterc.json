{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "UTC",
  "schedule": [
    "before 3am on Monday"
  ],
  "kubernetes": {
    "enabled": true,
    "managerFilePatterns": [
      "apps/base/**/*.yaml",
      "apps/overlays/**/*.yaml"
    ]
  },
  "ignorePaths": [
    "ansible/**",
    "terraform/**"
  ],
  "packageRules": [
    {
      "matchCategories": [
        "docker"
      ],
      "enabled": true,
      "automerge": false
    },
    {
      "description": "Group all image updates together",
      "matchDatasources": [
        "docker"
      ],
      "groupName": "App Container Images",
      "groupSlug": "app-images"
    },
    {
      "description": "Update busybox and other utility images separately",
      "matchPackageNames": ["busybox"],
      "groupName": "Utility Images",
      "groupSlug": "utility-images"
    },
    {
      "description": "Longhorn only supports upgrading one minor version at a time, so propose each minor separately instead of jumping straight to latest",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["longhorn"],
      "separateMultipleMinor": true
    }
  ],
  "prConcurrentLimit": 2,
  "semanticCommits": "enabled",
  "labels": ["renovate"],
  "assignees": ["alfiemellor"]
}
